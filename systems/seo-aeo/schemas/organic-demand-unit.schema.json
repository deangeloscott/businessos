{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrganicDemandUnit",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^odm_[A-Za-z0-9_-]+$"
    },
    "object_type": {
      "const": "OrganicDemandUnit"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "business_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "problem_question": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "awareness_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "buyer_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "market_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "audience_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "offer_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "business_value": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "object_type",
    "schema_version",
    "business_id",
    "topic",
    "problem_question",
    "intent",
    "surfaces",
    "evidence_refs",
    "status"
  ]
}
