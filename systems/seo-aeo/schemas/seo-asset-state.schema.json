{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEOAssetState",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^sas_[A-Za-z0-9_-]+$"
    },
    "object_type": {
      "const": "SEOAssetState"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "business_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "asset_ref": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "indexability": {
      "type": "object"
    },
    "index_state": {
      "type": "object"
    },
    "crawl_state": {
      "type": "object"
    },
    "intent_alignment": {
      "type": "object"
    },
    "organic_demand_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "search_visibility": {
      "type": "object"
    },
    "aeo_visibility": {
      "type": "object"
    },
    "internal_authority": {
      "type": "object"
    },
    "external_authority": {
      "type": "object"
    },
    "structured_data_state": {
      "type": "object"
    },
    "serp_presentation": {
      "type": "object"
    },
    "organic_performance": {
      "type": "object"
    },
    "issues": {
      "type": "array"
    },
    "last_observed": {
      "type": "string"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "object_type",
    "schema_version",
    "business_id",
    "asset_ref",
    "last_observed"
  ]
}
