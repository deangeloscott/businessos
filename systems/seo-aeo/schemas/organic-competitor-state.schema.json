{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrganicCompetitorState",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ocs_[A-Za-z0-9_-]+$"
    },
    "object_type": {
      "const": "OrganicCompetitorState"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "business_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "entity_name": {
      "type": "string",
      "minLength": 1
    },
    "competitor_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "business_competitor": {
      "type": "boolean"
    },
    "search_overlap": {
      "type": "object"
    },
    "aeo_overlap": {
      "type": "object"
    },
    "authority_overlap": {
      "type": "object"
    },
    "content_overlap": {
      "type": "object"
    },
    "markets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "last_observed": {
      "type": "string"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "object_type",
    "schema_version",
    "business_id",
    "entity_name",
    "business_competitor",
    "last_observed"
  ]
}
