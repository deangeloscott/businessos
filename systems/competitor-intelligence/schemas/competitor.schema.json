{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Competitor",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cmp_[A-Za-z0-9_-]+$"
    },
    "object_type": {
      "const": "Competitor"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "business_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "official_domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "surface_type": {
                "type": "string",
                "enum": [
                  "social",
                  "review",
                  "advertising",
                  "marketplace",
                  "directory",
                  "app_store",
                  "community",
                  "other"
                ]
              },
              "platform": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "handle": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "external_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "region": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "probable",
                  "ambiguous",
                  "rejected"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "surface_type",
              "platform",
              "url",
              "handle",
              "external_id",
              "region",
              "status",
              "evidence_refs"
            ]
          }
        }
      },
      "required": [
        "official_domains",
        "aliases",
        "profiles"
      ]
    },
    "competitor_type": {
      "type": "string",
      "minLength": 1
    },
    "markets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "audiences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "products_services": {
      "type": "array"
    },
    "known_offers": {
      "type": "array"
    },
    "known_pricing": {
      "type": "array"
    },
    "positioning_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "active_insight_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "observation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "last_reviewed": {
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "object_type",
    "schema_version",
    "business_id",
    "name",
    "competitor_type"
  ]
}
