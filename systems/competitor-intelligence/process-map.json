    {"id":"advertising","entry_contract":"competitor.analysis.advertising","result":"Understand observable competitor advertising patterns."},
    {"id":"content-strategy","entry_contract":"competitor.analysis.content-strategy","result":"Understand competitor content strategy."},
    {"id":"customer-sentiment","entry_contract":"competitor.analysis.customer-sentiment","result":"Understand recurring customer praise/complaints."},
    {"id":"tactic-validation","entry_contract":"competitor.analysis.tactic-validation","result":"Determine whether a tactic likely works and why."},
    {"id":"strength-weakness","entry_contract":"competitor.analysis.strength-weakness","result":"Assess scoped competitor strengths and vulnerabilities."},
    {"id":"strategy-change","entry_contract":"competitor.analysis.strategic-change","result":"Detect and interpret strategic movement."},
