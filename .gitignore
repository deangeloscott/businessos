# BusinessOS public-repository safety defaults
# Keep product templates/source in Git; keep live user/business workspace state out of the public product repository.

# Business instances created from instances/_template/
/instances/*
!/instances/_template/
!/instances/_template/**

# Runtime state (retain documentation placeholders when present)
/runtime/*/*
!/runtime/*/README.md

# Product-local human knowledge and attachments are user/workspace state.
/knowledge/
/attachments/

# Local workspace selection/profile metadata. External workspaces keep their own portable profile.
/.businessos/workspace.json

# Local secrets and environment files
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
secrets/
credentials/

# Local archives / exports / backups
*.bak
*.backup
*.tmp
*.swp
*.swo
*.log
*.sqlite
*.sqlite3
*.db
*.csv
*.parquet
*.arrow
*.ndjson
*.zip
*.tar
*.tar.gz

# Python / editors / OS
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.DS_Store
Thumbs.db
.idea/
.vscode/

# Deterministic release/build artifacts (regenerate with scripts/generate_registry.py)
/generated/
/docs/build/
