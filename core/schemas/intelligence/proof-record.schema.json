{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProofRecord",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^prf_[A-Za-z0-9_-]+$"
    },
    "object_type": {
      "const": "ProofRecord"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "business_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "producer_system": {
      "enum": [
        "core",
        "customer-intelligence",
        "competitor-intelligence",
        "industry-intelligence",
        "seo-aeo",
        "content-synthesis",
        "marketing-synthesis",
        "customer-optimization"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "proof_type": {
      "enum": [
        "testimonial",
        "review",
        "customer_quote",
        "before_after",
        "case_result",
        "case_study",
        "demonstration",
        "metric",
        "certification",
        "third_party_validation",
        "user_generated_content",
        "other"
      ]
    },
    "claim_supported": {
      "type": "string",
      "minLength": 1
    },
    "subject_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^src_[A-Za-z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "observation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^obs_[A-Za-z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "asset_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ast_[A-Za-z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "audience_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "product_service_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "offer_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "before_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "after_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "verbatim_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "permission_status": {
      "enum": [
        "unknown",
        "public_quote_only",
        "permission_required",
        "permission_granted",
        "restricted",
        "prohibited"
      ]
    },
    "usage_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_strength": {
      "enum": [
        "weak",
        "moderate",
        "strong"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "review_after": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "enum": [
        "candidate",
        "active",
        "stale",
        "restricted",
        "superseded",
        "archived"
      ]
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "object_type",
    "schema_version",
    "business_id",
    "producer_system",
    "proof_type",
    "claim_supported",
    "source_refs",
    "permission_status",
    "evidence_strength",
    "confidence",
    "status",
    "created_at",
    "updated_at"
  ]
}
