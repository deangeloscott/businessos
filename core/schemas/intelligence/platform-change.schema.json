{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlatformChange",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^plc_[A-Za-z0-9_-]+$"
    },
    "object_type": {
      "const": "PlatformChange"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "business_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "owner_system": {
      "enum": [
        "core",
        "customer-intelligence",
        "competitor-intelligence",
        "industry-intelligence",
        "seo-aeo",
        "content-synthesis",
        "marketing-synthesis",
        "customer-optimization"
      ]
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "semantic_key": {
      "type": "string",
      "minLength": 1
    },
    "state_summary": {
      "type": "string",
      "minLength": 1
    },
    "state_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "change_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "current",
        "superseded",
        "archived"
      ]
    },
    "authority": {
      "enum": [
        "official_platform",
        "formal_standard",
        "first_party_platform",
        "high_quality_research",
        "corroborated_external",
        "community_signal",
        "unknown"
      ]
    },
    "materiality": {
      "enum": [
        "not_material",
        "low",
        "medium",
        "high",
        "critical",
        "unknown"
      ]
    },
    "effective_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "first_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verification_count": {
      "type": "integer",
      "minimum": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "affected_contract_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "affected_object_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^plc_[A-Za-z0-9_-]+$"
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^plc_[A-Za-z0-9_-]+$"
    },
    "retention_class": {
      "enum": [
        "operational",
        "durable"
      ]
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "object_type",
    "schema_version",
    "business_id",
    "owner_system",
    "platform",
    "topic",
    "semantic_key",
    "state_summary",
    "state_fingerprint",
    "status",
    "authority",
    "materiality",
    "first_verified_at",
    "last_verified_at",
    "verification_count",
    "retention_class"
  ]
}
