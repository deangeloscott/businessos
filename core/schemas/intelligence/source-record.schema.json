{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceRecord",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^src_[A-Za-z0-9_-]+$"
    },
    "object_type": {
      "const": "SourceRecord"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "business_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_type": {
      "type": "string",
      "minLength": 1
    },
    "source_reference": {
      "type": "string",
      "minLength": 1
    },
    "subject_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "origin": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "content_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_hash_target": {
      "enum": ["captured_text", "record_payload", "file_bytes"],
      "description": "Hash representation: exact UTF-8 captured_text; record_payload serialized as JSON with sorted keys, ensure_ascii=false and default separators; or bytes at content_hash_reference. Omitted legacy targets are not assumed to describe binary evidence."
    },
    "content_hash_reference": {
      "type": "string",
      "minLength": 1,
      "description": "Local storage reference for file_bytes integrity checking; never fetched from the network by validation."
    },
    "access_class": {
      "enum": ["public", "restricted", "private", "unknown"],
      "description": "Mechanical access classification, separate from descriptive access_scope and origin. Optional for legacy records; no acquisition provenance is inferred."
    },
    "access_scope": {
      "type": "string",
      "minLength": 1
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "object_type",
    "schema_version",
    "business_id",
    "source_type",
    "source_reference",
    "retrieved_at",
    "access_scope"
  ]
}
