{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InnovationExchangeIndex",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {"const": "1.2"},
    "exchange_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "package_id": {"type": "string", "pattern": "^ipkg_[A-Za-z0-9_-]+$"},
          "innovation_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "workflow_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "detail_level": {"enum": ["workflow_only", "anonymized_evidence", "full_case_study"]},
          "identity_level": {"enum": ["anonymous", "pseudonymous", "named"]},
          "artifact_reference": {"type": "string", "minLength": 1},
          "reported_evidence": {"type": ["object", "null"]}
        },
        "required": ["package_id", "innovation_fingerprint", "workflow_id", "title", "purpose", "detail_level", "identity_level", "artifact_reference", "reported_evidence"]
      }
    }
  },
  "required": ["format_version", "exchange_id", "generated_at", "entries"]
}
