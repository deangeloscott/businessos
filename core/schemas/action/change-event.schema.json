{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangeEvent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^chg_[A-Za-z0-9_-]+$"},
    "object_type": {"const": "ChangeEvent"},
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "business_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "lineage": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "summary": {"type": "string", "minLength": 1},
    "change_kind": {"type": ["string", "null"]},
    "target_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "before_state": {},
    "change_details": {"type": "array"},
    "after_state": {},
    "executor": {"type": ["string", "null"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["planned", "applying", "applied", "partial", "failed", "rolled_back", "closed", "verifying", "verified"]},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "result_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "decision_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "work_request_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "rollback": {"type": ["object", "null"]},
    "extensions": {"type": "object"}
  },
  "required": [
    "id",
    "object_type",
    "schema_version",
    "business_id",
    "summary",
    "occurred_at"
  ]
}
