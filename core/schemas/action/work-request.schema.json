{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^wrk_[A-Za-z0-9_-]+$"},
    "object_type": {"const": "WorkRequest"},
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "business_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "lineage": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},

    "purpose": {"type": "string", "minLength": 1},
    "requested_output": {"type": "string", "minLength": 1},
    "context_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "requested_by": {"type": ["string", "null"]},
    "assigned_to": {"type": ["string", "null"]},
    "due_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {"enum": ["open", "in_progress", "completed", "blocked", "cancelled"]},
    "result_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "decision_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "notes": {"type": ["string", "null"]},

    "requesting_system": {"type": "string"},
    "executing_system": {"type": "string"},
    "origin_opportunity_ref": {"type": "string", "minLength": 1},
    "origin_action_ref": {"type": "string", "minLength": 1},
    "initiative_ref": {"type": ["string", "null"]},
    "required_output": {"type": "string", "minLength": 1},
    "required_context_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "success_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "required_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "return_contract": {"type": "string", "minLength": 1},
    "returned_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},

    "extensions": {"type": "object"}
  },
  "required": [
    "id",
    "object_type",
    "schema_version",
    "business_id",
    "purpose",
    "status"
  ],
  "allOf": [
    {
      "anyOf": [
        {"required": ["requested_output"]},
        {"required": ["required_output"]}
      ]
    }
  ]
}
