{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asset",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^ast_[A-Za-z0-9_-]+$"},
    "object_type": {"const": "Asset"},
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "business_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "lineage": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "asset_type": {"type": "string", "minLength": 1},
    "business_role": {"type": "string", "minLength": 1},
    "location_reference": {"type": ["string", "null"]},
    "version": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "extensions": {"type": "object"}
  },
  "required": ["id", "object_type", "schema_version", "business_id", "asset_type", "business_role", "version", "status"]
}
