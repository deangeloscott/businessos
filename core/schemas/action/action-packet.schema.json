{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActionPacket",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^act_[A-Za-z0-9_-]+$"
    },
    "object_type": {
      "const": "ActionPacket"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "business_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "owner_system": {
      "enum": [
        "core",
        "customer-intelligence",
        "competitor-intelligence",
        "industry-intelligence",
        "seo-aeo",
        "content-synthesis",
        "marketing-synthesis",
        "customer-optimization"
      ]
    },
    "opportunity_ref": {
      "type": "string",
      "minLength": 1
    },
    "initiative_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "executor_type": {
            "enum": [
              "AI",
              "DETERMINISTIC",
              "INTEGRATION",
              "HUMAN",
              "HYBRID"
            ]
          },
          "required_capability": {
            "type": [
              "string",
              "null"
            ]
          },
          "inputs": {
            "type": "array"
          },
          "expected_outputs": {
            "type": "array"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "risk": {
            "type": "string",
            "minLength": 1
          },
          "reversibility": {
            "type": "string",
            "minLength": 1
          },
          "autonomy_ceiling": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "approval_requirement": {
            "type": [
              "string",
              "null"
            ]
          },
          "success_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "fallback": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "action_id",
          "description",
          "executor_type",
          "expected_outputs",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "object_type",
    "schema_version",
    "business_id",
    "owner_system",
    "opportunity_ref",
    "status",
    "actions"
  ]
}
