{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incident",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^inc_[A-Za-z0-9_-]+$"},
    "object_type": {"const": "Incident"},
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "business_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "lineage": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "incident_type": {"type": "string", "minLength": 1},
    "severity": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "subject_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "observation_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "containment_actions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "resolution_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "extensions": {"type": "object"}
  },
  "required": ["id", "object_type", "schema_version", "business_id", "incident_type", "severity", "status"]
}
