{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approval",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^apr_[A-Za-z0-9_-]+$"
    },
    "object_type": {
      "const": "Approval"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "business_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "requested_by": {
      "type": "string",
      "minLength": 1
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "action_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "risk": {
      "type": "string",
      "minLength": 1
    },
    "approver": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "conditional",
        "expired"
      ]
    },
    "decision_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "expiry": {
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "object_type",
    "schema_version",
    "business_id",
    "requested_by",
    "requested_at",
    "action_refs",
    "decision"
  ]
}
