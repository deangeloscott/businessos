{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextUpdateProposal",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cup_[A-Za-z0-9_-]+$"
    },
    "object_type": {
      "const": "ContextUpdateProposal"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "business_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "producer_system": {
      "enum": [
        "core",
        "customer-intelligence",
        "competitor-intelligence",
        "industry-intelligence",
        "seo-aeo",
        "content-synthesis",
        "marketing-synthesis",
        "customer-optimization"
      ]
    },
    "target_ref": {
      "type": "string",
      "minLength": 1
    },
    "target_field": {
      "type": [
        "string",
        "null"
      ]
    },
    "current_value": {},
    "proposed_value": {},
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "change_class": {
      "enum": [
        "factual_sync",
        "business_decision",
        "brand_decision",
        "commercial_term",
        "policy_compliance",
        "other"
      ]
    },
    "status": {
      "enum": [
        "proposed",
        "applied",
        "rejected",
        "superseded",
        "withdrawn"
      ]
    },
    "decision_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "object_type",
    "schema_version",
    "business_id",
    "producer_system",
    "target_ref",
    "reason",
    "evidence_refs",
    "change_class",
    "status",
    "created_at",
    "updated_at"
  ]
}
