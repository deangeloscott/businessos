{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Objective",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^obj_[A-Za-z0-9_-]+$"},
    "object_type": {"const": "Objective"},
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "business_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "lineage": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "name": {"type": "string", "minLength": 1},
    "metric_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "target": {},
    "horizon": {"type": "string", "minLength": 1},
    "priority": {"type": "number", "description": "Optional organization-supplied prioritization. Absence means priority is unknown or not explicitly ranked; AURA must not infer it from storage or input order."},
    "extensions": {"type": "object"}
  },
  "required": ["id", "object_type", "schema_version", "business_id", "name"]
}
