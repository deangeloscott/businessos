{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BusinessClaim",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^clm_[A-Za-z0-9_-]+$"},
    "object_type": {"const": "BusinessClaim"},
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "business_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "lineage": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "statement": {"type": "string", "minLength": 1},
    "claim_kind": {"enum": ["approved_business_claim", "constraint", "prohibition", "candidate"]},
    "status": {"enum": ["approved", "provisional", "prohibited", "retired"]},
    "authority": {"enum": ["explicit_user", "verified_first_party", "derived_inference", "candidate_strategy"]},
    "source_ref": {"type": ["string", "null"]},
    "support_quote": {"type": ["string", "null"]},
    "extensions": {"type": "object"}
  },
  "required": ["id", "object_type", "schema_version", "business_id", "statement", "claim_kind", "status", "authority"]
}
