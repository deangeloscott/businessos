{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ProcessExtension",
  "type":"object",
  "additionalProperties":false,
  "properties":{
    "id":{"type":"string","pattern":"^pex_[A-Za-z0-9_-]+$"},
    "object_type":{"const":"ProcessExtension"},
    "schema_version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "business_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9_-]{0,63}$"},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"},
    "mode":{"enum":["augment_contract","local_playbook"]},
    "owner_system":{"enum":["core","customer-intelligence","competitor-intelligence","industry-intelligence","seo-aeo","content-synthesis","marketing-synthesis","customer-optimization"]},
    "target_contract_id":{"type":["string","null"]},
    "local_contract_id":{"type":["string","null"]},
    "title":{"type":"string","minLength":1},
    "purpose":{"type":"string","minLength":1},
    "route_terms":{"type":"array","items":{"type":"string","minLength":2},"uniqueItems":true},
    "status":{"enum":["active","inactive","retired"]},
    "scope":{"enum":["business","team","role","operator"]},
    "scope_ref":{"type":["string","null"]},
    "applies_when":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "does_not_apply_when":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "reads":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "writes":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "required_capabilities":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "optional_capabilities":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "instructions":{"type":"array","items":{"type":"string","minLength":1},"minItems":1},
    "verification":{"type":"array","items":{"type":"string","minLength":1},"minItems":1},
    "source_kind":{"enum":["organization_authored","learning_evolved"]},
    "source_learning_refs":{"type":"array","items":{"type":"string","pattern":"^lrn_[A-Za-z0-9_-]+$"},"uniqueItems":true},
    "source_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "evidence_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "compatibility":{"type":"object","additionalProperties":false,"properties":{"aura_min":{"type":["string","null"]},"aura_max":{"type":["string","null"]}},"required":["aura_min","aura_max"]},
    "extensions":{"type":"object"}
  },
  "required":["id","object_type","schema_version","business_id","created_at","updated_at","mode","owner_system","target_contract_id","local_contract_id","title","purpose","route_terms","status","scope","scope_ref","applies_when","does_not_apply_when","reads","writes","required_capabilities","optional_capabilities","instructions","verification","source_learning_refs","evidence_refs","compatibility"],
  "allOf":[
    {"if":{"properties":{"mode":{"const":"augment_contract"}}},"then":{"properties":{"target_contract_id":{"type":"string","minLength":1}}}},
    {"if":{"properties":{"mode":{"const":"local_playbook"}}},"then":{"properties":{"local_contract_id":{"type":"string","pattern":"^custom\\.[a-z0-9][a-z0-9.-]*$"}}}},
    {"anyOf":[
      {"properties":{"source_learning_refs":{"minItems":1}}},
      {"required":["source_refs"],"properties":{"source_refs":{"minItems":1}}}
    ]},
    {"if":{"properties":{"source_kind":{"const":"learning_evolved"}},"required":["source_kind"]},"then":{"properties":{"source_learning_refs":{"minItems":1}}}},
    {"if":{"properties":{"source_kind":{"const":"organization_authored"}},"required":["source_kind"]},"then":{"required":["source_refs"],"properties":{"source_refs":{"minItems":1}}}}
  ]
}
