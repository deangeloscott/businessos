{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"WorkflowEvolutionProposal",
  "type":"object",
  "additionalProperties":false,
  "properties":{
    "id":{"type":"string","pattern":"^(?:wev|pev)_[A-Za-z0-9_-]+$"},
    "object_type":{"const":"WorkflowEvolutionProposal"},
    "schema_version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "business_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9_-]{0,63}$"},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"},
    "owner_system":{"enum":["core","customer-intelligence","competitor-intelligence","industry-intelligence","seo-aeo","content-synthesis","marketing-synthesis","customer-optimization"]},
    "change_kind":{"enum":["augment_existing","new_local_workflow","canonical_revision"]},
    "proposed_scope":{"enum":["business","domain","system"]},
    "target_contract_id":{"type":["string","null"]},
    "proposed_local_contract_id":{"type":["string","null"]},
    "title":{"type":"string","minLength":1},
    "summary":{"type":"string","minLength":1},
    "learning_refs":{"type":"array","items":{"type":"string","pattern":"^lrn_[A-Za-z0-9_-]+$"},"minItems":1,"uniqueItems":true},
    "evidence_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "applies_when":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "does_not_apply_when":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "discovery_terms":{"type":"array","items":{"type":"string","minLength":2},"uniqueItems":true},
    "reads":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "writes":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "instructions":{"type":"array","items":{"type":"string","minLength":1},"minItems":1},
    "verification":{"type":"array","items":{"type":"string","minLength":1},"minItems":1},
    "status":{"enum":["candidate","adopted","rejected","superseded"]},
    "extensions":{"type":"object"}
  },
  "required":["id","object_type","schema_version","business_id","created_at","updated_at","owner_system","change_kind","proposed_scope","target_contract_id","proposed_local_contract_id","title","summary","learning_refs","evidence_refs","applies_when","does_not_apply_when","discovery_terms","reads","writes","instructions","verification","status"],
  "allOf":[
    {"if":{"properties":{"change_kind":{"const":"augment_existing"}}},"then":{"properties":{"target_contract_id":{"type":"string","minLength":1}}}},
    {"if":{"properties":{"change_kind":{"const":"new_local_workflow"}}},"then":{"properties":{"proposed_local_contract_id":{"type":"string","pattern":"^custom\\.[a-z0-9][a-z0-9.-]*$"}}}}
  ]
}
