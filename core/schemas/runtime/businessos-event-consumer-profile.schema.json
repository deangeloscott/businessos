{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BusinessOSEventConsumerProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "type": "string",
      "minLength": 1
    },
    "consumer_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "event_families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner_system": {
            "type": "string",
            "minLength": 1
          },
          "semantic_intents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "provider_examples": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "materiality_triggers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "preferred_contracts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "side_effect_posture": {
            "enum": [
              "evaluate_only",
              "governed_handoff_possible"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "owner_system",
          "semantic_intents",
          "provider_examples",
          "materiality_triggers",
          "preferred_contracts",
          "side_effect_posture",
          "notes"
        ]
      }
    }
  },
  "required": [
    "format_version",
    "consumer_id",
    "role",
    "principles",
    "event_families"
  ]
}
