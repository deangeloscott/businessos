{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OperatorProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "phone": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "email",
        "phone",
        "location"
      ]
    },
    "reuse_across_businesses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "name",
          "email",
          "phone",
          "location"
        ]
      },
      "uniqueItems": true
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "format_version",
    "profile_id",
    "identity",
    "reuse_across_businesses",
    "notes"
  ]
}
