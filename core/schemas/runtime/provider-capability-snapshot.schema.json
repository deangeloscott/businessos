{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderCapabilitySnapshot",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "connection_ref": {
      "type": "string",
      "minLength": 1
    },
    "discovered_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_kind": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "bound",
              "candidate",
              "not_detected"
            ]
          },
          "provider_action": {
            "type": "string",
            "minLength": 1
          },
          "matched_signals": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "auto_bind": {
            "type": "boolean"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "capability",
          "status",
          "provider_action",
          "matched_signals",
          "auto_bind",
          "notes"
        ]
      }
    }
  },
  "required": [
    "format_version",
    "provider_id",
    "environment",
    "connection_ref",
    "discovered_at",
    "source_kind",
    "source_sha256",
    "capabilities"
  ]
}
