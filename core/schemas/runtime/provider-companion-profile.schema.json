{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderCompanionProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "portable_dependency": {
      "type": "boolean"
    },
    "discovery_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "purpose"
        ]
      }
    },
    "capability_mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "businessos_capability": {
            "type": "string",
            "minLength": 1
          },
          "provider_action": {
            "type": "string",
            "minLength": 1
          },
          "signals_any": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "auto_bind": {
            "type": "boolean"
          },
          "preferred_use": {
            "type": "string",
            "minLength": 1
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "businessos_capability",
          "provider_action",
          "signals_any",
          "auto_bind",
          "preferred_use",
          "limits"
        ]
      }
    },
    "routing_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "format_version",
    "provider_id",
    "role",
    "portable_dependency",
    "discovery_sources",
    "capability_mappings",
    "routing_rules"
  ]
}
