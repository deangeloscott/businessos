{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapabilityBinding",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "provider_action": {
      "type": "string",
      "minLength": 1
    },
    "connection_ref": {
      "type": "string",
      "minLength": 1
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "coverage": {
      "type": [
        "string",
        "null"
      ]
    },
    "reliability": {
      "type": [
        "number",
        "null"
      ]
    },
    "freshness": {
      "type": [
        "string",
        "null"
      ]
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "required": [
    "capability",
    "provider_action",
    "connection_ref",
    "permissions",
    "enabled"
  ]
}
