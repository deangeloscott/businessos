{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublisherMetadata",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {"type": "string", "minLength": 1},
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": ["string", "null"]},
        "name": {"type": ["string", "null"]},
        "canonical_project_url": {"type": ["string", "null"]},
        "documentation_url": {"type": ["string", "null"]},
        "support_url": {"type": ["string", "null"]},
        "creator_name": {"type": ["string", "null"]},
        "product_name": {"type": ["string", "null"]},
        "product_acronym": {"type": ["string", "null"]},
        "product_name_expansion": {"type": ["string", "null"]},
        "product_descriptor": {"type": ["string", "null"]},
        "legacy_public_name": {"type": ["string", "null"]},
        "creator_url": {"type": ["string", "null"]},
        "publisher_url": {"type": ["string", "null"]}
      },
      "required": [
        "id",
        "name",
        "creator_name",
        "canonical_project_url",
        "documentation_url",
        "support_url",
        "product_name",
        "product_acronym",
        "product_name_expansion",
        "product_descriptor",
        "legacy_public_name",
        "creator_url",
        "publisher_url"
      ]
    },
    "updates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest_url": {"type": ["string", "null"]},
        "policy": {"type": "string", "enum": ["disabled", "manual_or_host_check", "opt_in_metadata_only"]},
        "channel": {"type": "string", "enum": ["stable"]},
        "source": {"type": "string", "enum": ["github_releases"]},
        "repository": {"type": "string", "minLength": 1},
        "latest_release_api": {"type": "string", "minLength": 1},
        "auto_download": {"type": "boolean"},
        "auto_install": {"type": "boolean"},
        "business_data_transmitted": {"type": "boolean"},
        "note": {"type": "string", "minLength": 1}
      },
      "required": [
        "manifest_url",
        "policy",
        "channel",
        "source",
        "repository",
        "latest_release_api",
        "auto_download",
        "auto_install",
        "business_data_transmitted",
        "note"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preserve_in_derivative_distributions": {"type": "boolean"},
        "show_to_agents": {"type": "boolean"},
        "note": {"type": "string", "minLength": 1}
      },
      "required": ["preserve_in_derivative_distributions", "show_to_agents", "note"]
    }
  },
  "required": ["format_version", "publisher", "updates", "provenance"]
}
