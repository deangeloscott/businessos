{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderEventInteroperability",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "plane": {
      "type": "string",
      "minLength": 1
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evaluation_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "action_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "non_live_modes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "degraded_mode": {
          "type": "string",
          "minLength": 1
        },
        "requires_host_delivery": {
          "type": "boolean"
        }
      },
      "required": [
        "evaluation_modes",
        "action_modes",
        "non_live_modes",
        "degraded_mode",
        "requires_host_delivery"
      ]
    },
    "mode_behavior": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "discovery_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "format_version",
    "provider_id",
    "plane",
    "activation",
    "mode_behavior",
    "discovery_paths",
    "rules"
  ]
}
