{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExternalResearchProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "type": "string",
      "minLength": 1
    },
    "business_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "inherit_operator_profile": {
      "type": "boolean"
    },
    "use_business_context_when_truthful": {
      "type": "boolean"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "organization": {
          "type": [
            "string",
            "null"
          ]
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "phone": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "website": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "organization",
        "email",
        "phone",
        "location",
        "website"
      ]
    },
    "allowed_without_additional_approval": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "requires_approval": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "prohibited": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "format_version",
    "business_id",
    "inherit_operator_profile",
    "use_business_context_when_truthful",
    "identity",
    "allowed_without_additional_approval",
    "requires_approval",
    "prohibited",
    "notes"
  ]
}
