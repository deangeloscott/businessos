{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "business_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_event_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "root_event_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_event_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "delivery_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "subscription_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_schema_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "consumer_capability_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority": {
      "type": [
        "string",
        "null"
      ]
    },
    "replay_mode": {
      "type": [
        "string",
        "null"
      ]
    },
    "reaction_depth": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "event_id",
    "event_type",
    "business_id",
    "producer",
    "subject_ref",
    "occurred_at",
    "correlation_id"
  ]
}
