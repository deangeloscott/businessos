{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventReactionDecision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "business_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "source_event_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "root_event_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_event_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "disposition": {
      "enum": [
        "ignore",
        "defer",
        "coalesce",
        "evaluate",
        "blocked",
        "fallback"
      ]
    },
    "materiality": {
      "enum": [
        "not_material",
        "low",
        "medium",
        "high",
        "critical",
        "unknown"
      ]
    },
    "routed_contract": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "reaction_depth": {
      "type": "integer",
      "minimum": 0
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coalesced_event_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "decision_id",
    "business_id",
    "event_id",
    "disposition",
    "materiality",
    "idempotency_key",
    "reaction_depth",
    "reason_codes",
    "coalesced_event_refs",
    "created_at"
  ]
}
