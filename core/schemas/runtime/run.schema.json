{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "business_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "task": {"type": "string", "minLength": 1},
    "method_type": {
      "enum": ["aura_playbook", "aura_workflow", "external_skill", "model_created", "ad_hoc"],
      "description": "How the work was actually performed. This is optional provenance, not execution authority or conformance state."
    },
    "method_ref": {"type": ["string", "null"], "minLength": 1},
    "playbook_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "A human-meaningful AURA Playbook identifier when that Playbook materially framed the work."
    },
    "contract_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "Compatibility field for the detailed AURA Workflow ID. Retained so existing v0.1.x receipts remain readable."
    },
    "status": {"enum": ["active", "completed"]},
    "focus_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "operator_ref": {"type": ["string", "null"], "minLength": 1},
    "team_ref": {"type": ["string", "null"], "minLength": 1},
    "role_ref": {"type": ["string", "null"], "minLength": 1},
    "preference_output_type": {"type": ["string", "null"], "minLength": 1},
    "preference_channel": {"type": ["string", "null"], "minLength": 1},
    "preference_snapshot_ref": {"type": ["string", "null"], "minLength": 1},
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "description": "Compact organization-owned work receipt. Preserve material meaning, not transcripts or hidden reasoning.",
      "properties": {
        "format_version": {"type": "string", "minLength": 1},
        "purpose": {"const": "organizational_work_receipt"},
        "state": {"enum": ["active", "completed"]},
        "method_type": {"enum": ["aura_playbook", "aura_workflow", "external_skill", "model_created", "ad_hoc"]},
        "method_ref": {"type": ["string", "null"], "minLength": 1},
        "summary": {"type": ["string", "null"]},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "result_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "decision_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "unresolved": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "completed_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "required": ["format_version", "purpose", "state", "method_type", "evidence_refs", "result_refs", "decision_refs", "unresolved"]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "required": ["run_id", "business_id", "task", "method_type", "status", "created_at", "updated_at"]
}
