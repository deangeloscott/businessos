{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opportunity",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^opp_[A-Za-z0-9_-]+$"},
    "object_type": {"const": "Opportunity"},
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "business_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "lineage": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "title": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "status": {"enum": ["candidate", "investigating", "qualified", "prioritized", "blocked", "rejected", "superseded", "reopened", "closed"]},
    "objective_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "origin_insight_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "evidence_links": {"type": "array"},
    "affected_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "diagnosis": {"type": "string", "minLength": 1},
    "expected_value": {"type": "object"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "urgency": {"type": "number", "minimum": 0, "maximum": 1},
    "strategic_leverage": {"type": "number", "minimum": 0, "maximum": 1},
    "material_cost": {"type": "object"},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "priority_assessment": {"type": "object"},
    "recommended_intervention_types": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "domain_data": {"type": "object"},
    "extensions": {"type": "object"},
    "reasoning_basis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fact_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "minItems": 1},
        "measured_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "inferences": {"type": "array", "items": {"type": "object", "additionalProperties": false, "properties": {"statement": {"type": "string", "minLength": 1}, "basis_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "minItems": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}, "required": ["statement", "basis_refs"]}},
        "unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "required": ["fact_refs", "measured_refs", "inferences", "unknowns"]
    }
  },
  "required": ["id", "object_type", "schema_version", "business_id", "title", "statement", "status", "objective_refs"],
  "allOf": [{"if": {"properties": {"status": {"enum": ["qualified", "prioritized"]}}, "required": ["status"]}, "then": {"required": ["reasoning_basis"]}}]
}
