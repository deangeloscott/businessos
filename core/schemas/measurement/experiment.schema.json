{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experiment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^exp_[A-Za-z0-9_-]+$"},
    "object_type": {"const": "Experiment"},
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "business_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "lineage": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "hypothesis": {"type": "string", "minLength": 1},
    "population": {"type": "string", "minLength": 1},
    "treatment": {"type": "string", "minLength": 1},
    "control_baseline": {"type": "string", "minLength": 1},
    "success_metric_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "guardrail_metric_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "evaluation_rule": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "change_refs": {"type": "array", "items": {"type": "string", "pattern": "^chg_[A-Za-z0-9_-]+$"}, "uniqueItems": true},
    "extensions": {"type": "object"}
  },
  "required": ["id", "object_type", "schema_version", "business_id", "hypothesis", "population", "treatment", "success_metric_refs", "status"]
}
