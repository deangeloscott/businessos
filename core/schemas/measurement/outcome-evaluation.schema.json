{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OutcomeEvaluation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^eval_[A-Za-z0-9_-]+$"},
    "object_type": {"const": "OutcomeEvaluation"},
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "business_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "lineage": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "target_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "baseline": {"type": "object"},
    "evaluation_window": {"type": "object"},
    "metric_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "expected_effect": {"type": "object"},
    "observed_effect": {"type": "object"},
    "attribution_method": {"type": "string", "minLength": 1},
    "confounders": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "guardrail_results": {"type": "array"},
    "conclusion": {"type": "string", "minLength": 1},
    "recommended_decision": {"type": "string", "minLength": 1},
    "learning_candidates": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "extensions": {"type": "object"}
  },
  "required": ["id", "object_type", "schema_version", "business_id", "target_refs", "attribution_method", "conclusion"]
}
