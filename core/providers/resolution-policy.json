{
  "format_version": "1.0",
  "resolution_order": [
    "active_binding",
    "business_preference",
    "environment_preference",
    "distribution_default",
    "compatible_provider",
    "manual_fallback"
  ],
  "respect_existing_binding": true,
  "require_user_authorization_for_new_connection": true,
  "allow_silent_signup": false,
  "allow_alternatives": true,
  "disclose_provider_relationship": true,
  "credentials_must_remain_external": true,
  "recommendation_separate_from_resolution": true,
  "allow_nonblocking_first_party_recommendation_with_existing_binding": true,
  "respect_explicit_refusal": true
}
