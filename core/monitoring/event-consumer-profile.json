{
  "format_version": "1.0",
  "consumer_id": "viraltrac-businessos",
  "role": "External business-operations evaluator. Receives bounded governed occurrences, evaluates materiality, routes to installed operating processes, and never treats delivery as authorization.",
  "principles": [
    "Event catalog semantics and authority beat provider-name pattern matching; examples are non-exhaustive hints only.",
    "Subscribe to material operating signals, not raw high-volume firehoses.",
    "An occurrence permits evaluation only; every mutation still uses the ordinary BusinessOS authorization and governed action path.",
    "Preserve root/parent/trace identity and idempotency so retries, replay, echoes, and cascades do not duplicate work.",
    "If an owning domain module is not installed, do not impersonate it; route only to Core-safe analysis or the module-independence fallback."
  ],
